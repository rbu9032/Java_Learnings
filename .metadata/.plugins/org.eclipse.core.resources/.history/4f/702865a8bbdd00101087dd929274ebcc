package com.rbu.restaurant.service.imp;

import org.springframework.stereotype.Service;

import com.rbu.restaurant.builder.UserBuilder;
import com.rbu.restaurant.dao.UserRepository;
import com.rbu.restaurant.dto.UserRequestDto;
import com.rbu.restaurant.dto.UserResponseDto;
import com.rbu.restaurant.model.User;
import com.rbu.restaurant.service.UserService;

@Service
public class UserServiceImpl implements UserService{

	UserRepository userRepository;
	
	public UserServiceImpl(UserRepository userRepository) {
		super();
		this.userRepository = userRepository;
	}



	@Override
	public UserResponseDto addUser(UserRequestDto userRequestDto) {
		User user = UserBuilder.buildUserFromUserDto(userRequestDto);
		User savedUser = userRepository.save(user);
		return new UserResponseDto(savedUser.getUserName(), savedUser.getPhoneNum(), savedUser.getEmail());
	}

}
